# Copia este archivo como .env.docker y llena los valores reales.
# No subas .env.docker a git ni lo compartas en capturas.

# Puerto externo del servidor. Internamente la app usa 3000.
APP_PORT=3001

# Imagen que se construira o publicara en Docker Hub.
# Ejemplo real: DOCKER_IMAGE=tu-usuario-dockerhub/analiza-intelligence:2026-07-30
DOCKER_IMAGE=analiza-intelligence:local

# PostgreSQL server-only. En Docker, usa el nombre del servicio de base.
DATABASE_URL=postgresql://analiza_app:change-me@postgres:5432/analiza_intelligence
APP_URL=https://example.com

# SMTP server-only para invitaciones y recuperacion de contrasena.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=mailer@example.com

# Server-only. Activa AnaliA como agente real.
# Nunca uses NEXT_PUBLIC_ para esta llave.
OPENAI_API_KEY=your-openai-api-key
ANALIA_OPENAI_MODEL=gpt-5
