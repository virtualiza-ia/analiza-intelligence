# Copia este archivo como .env.docker y llena los valores reales.
# No subas .env.docker a git ni lo compartas en capturas.

# Puerto externo del servidor. Internamente la app usa 3000.
APP_PORT=3001

# Imagen que se construira o publicara en Docker Hub.
# Ejemplo real: DOCKER_IMAGE=tu-usuario-dockerhub/analiza-intelligence:2026-07-30
DOCKER_IMAGE=analiza-intelligence:local

# Supabase. Estos dos valores son publicos para el navegador, pero deben
# coincidir con el proyecto real donde viviran usuarios, permisos y datos.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Activa AnaliA como agente real.
# Nunca uses NEXT_PUBLIC_ para esta llave.
OPENAI_API_KEY=your-openai-api-key
ANALIA_OPENAI_MODEL=gpt-5

# Produccion: desactiva el acceso demo.
ANALIZA_DISABLE_DEMO_ADMIN=true

# Solo para staging/demo publico. No usar junto con datos reales.
ANALIZA_ENABLE_DEMO_ADMIN=false
ANALIZA_DEMO_ADMIN_EMAIL=admin.demo@analiza.local
ANALIZA_DEMO_ADMIN_PASSWORD=change-this-demo-password
ANALIZA_DEMO_ADMIN_SESSION_TOKEN=change-this-demo-session-token
