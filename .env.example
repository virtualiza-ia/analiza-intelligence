# Server-only PostgreSQL connection used for authentication and application data.
DATABASE_URL=postgresql://analiza_app:change-me@localhost:5432/analiza_intelligence
APP_URL=http://localhost:3000

# Server-only SMTP used for invitations and password recovery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=mailer@example.com

# Server-only. Required to activate AnaliA as a real AI agent.
# Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
ANALIA_OPENAI_MODEL=gpt-5
