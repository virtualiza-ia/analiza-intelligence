# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Required to activate AnaliA as a real AI agent.
# Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
ANALIA_OPENAI_MODEL=gpt-5

# Optional. Use only for public demo/staging without real data.
ANALIZA_ENABLE_DEMO_ADMIN=false
ANALIZA_DEMO_ADMIN_EMAIL=admin.demo@analiza.local
ANALIZA_DEMO_ADMIN_PASSWORD=change-this-demo-password
ANALIZA_DEMO_ADMIN_SESSION_TOKEN=change-this-demo-session-token

# Server-only. Required for real user invitations with self-hosted PostgreSQL.
# Never expose these values with NEXT_PUBLIC_.
DATABASE_URL=postgresql://analiza_app:change-this-password@127.0.0.1:5432/analiza_intelligence
APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=analiza@interactivecore.app
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="Analiza BI <analiza@interactivecore.app>"
